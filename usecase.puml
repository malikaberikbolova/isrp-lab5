@startuml
left to right direction
actor Сотрудник
actor Диспетчер
actor "Университетское расписание" as Schedule

rectangle "Бронирование аудиторий" {
  usecase "Забронировать аудиторию" as UC1
  usecase "Посмотреть свободные аудитории" as UC2
  usecase "Отменить бронь" as UC3
  usecase "Посмотреть все брони" as UC4
  usecase "Заказать оборудование" as UC5
  usecase "Проверить доступность аудитории" as UC6
}

Сотрудник --> UC1
Сотрудник --> UC2
Сотрудник --> UC5
Диспетчер --> UC3
Диспетчер --> UC4
Schedule --> UC6

UC1 ..> UC6 : <<include>>
UC5 ..> UC6 : <<include>>
UC5 ..> UC1 : <<extend>>
@enduml